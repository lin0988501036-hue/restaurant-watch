FROM mcr.microsoft.com/playwright/python:v1.54.0-noble

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.116.1 \
    'uvicorn[standard]==0.35.0' \
    playwright==1.54.0 \
    apscheduler==3.11.0 \
    httpx==0.28.1 \
    pydantic==2.11.7 \
    pywebpush==2.0.3 \
    'cryptography>=45.0.0'

RUN mkdir -p /app/app && echo '' | base64 -d > /app/app/__init__.py
RUN mkdir -p /app/app && echo '' | base64 -d > /app/app/main.py
RUN mkdir -p /app/app/static && echo '' | base64 -d > /app/app/static/index.html
RUN mkdir -p /app/app/static && echo '' | base64 -d > /app/app/static/style.css
RUN mkdir -p /app/app/static && echo '' | base64 -d > /app/app/static/app.js
RUN mkdir -p /app/app/static && echo '' | base64 -d > /app/app/static/sw.js
RUN mkdir -p /app/app/static && echo '' | base64 -d > /app/app/static/manifest.webmanifest

RUN mkdir -p /app/data

EXPOSE 8000

CMD ["bash", "-lc", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
